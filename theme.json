{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {
    "useRootPaddingAwareAlignments": true,

    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },

    "color": {
      "defaultPalette":   false,
      "defaultGradients": false,
      "defaultDuotone":   false,
      "custom":           false,
      "customGradient":   false,
      "palette": [
        { "slug": "primary",     "color": "#000000", "name": "Primary" },
        { "slug": "secondary",   "color": "#333333", "name": "Secondary" },
        { "slug": "accent",      "color": "#666666", "name": "Accent" },
        { "slug": "surface",     "color": "#F5F5F5", "name": "Surface" },
        { "slug": "surface-alt", "color": "#E5E5E5", "name": "Surface Alt" },
        { "slug": "ink",         "color": "#111111", "name": "Text" },
        { "slug": "ink-light",   "color": "#555555", "name": "Text Light" },
        { "slug": "white",       "color": "#FFFFFF", "name": "White" }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "customFontSize":   false,
      "lineHeight":       false,
      "dropCap":          false,
      "fontStyle":        false,
      "fontWeight":       false,
      "letterSpacing":    false,
      "textDecoration":   false,
      "textTransform":    false,
      "fontSizes": [
        { "slug": "xxs",  "size": "0.625rem", "name": "Nota"       },
        { "slug": "xs",   "size": "0.875rem", "name": "Didascalia" },
        { "slug": "sm",   "size": "1rem",     "name": "Etichetta"  },
        { "slug": "base", "size": "1.125rem", "name": "Corpo"      },
        { "slug": "md",   "size": "1.25rem",  "name": "Titolo S"   },
        { "slug": "lg",   "size": "1.5rem",   "name": "Titolo M"   },
        { "slug": "xl",   "size": "2rem",     "name": "Titolo L"   },
        { "slug": "2xl",  "size": "2.5rem",   "name": "Display"    },
        { "slug": "3xl",  "size": "3rem",     "name": "Headline"   }
      ],
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "system-ui, -apple-system, sans-serif"
        }
      ]
    },

    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "xs",  "size": "1.0rem", "name": "XS"     },
        { "slug": "sm",  "size": "1.6rem", "name": "Small"  },
        { "slug": "md",  "size": "2.4rem", "name": "Medium" },
        { "slug": "lg",  "size": "4.0rem", "name": "Large"  },
        { "slug": "xl",  "size": "8.0rem", "name": "XL"     }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },

    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "sm", "shadow": "0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06)",   "name": "SM" },
        { "slug": "md", "shadow": "0 4px 6px rgba(0,0,0,.07), 0 2px 4px rgba(0,0,0,.05)",   "name": "MD" },
        { "slug": "lg", "shadow": "0 10px 15px rgba(0,0,0,.08), 0 4px 6px rgba(0,0,0,.04)", "name": "LG" }
      ]
    },

    "custom": {
      "radius": {
        "sm":   "0.8rem",
        "md":   "1.6rem",
        "full": "8.0rem"
      },
      "transition": "150ms ease"
    },

    "blocks": {
      "core/navigation": {
        "typography": { "defaultFontSizes": false }
      },
      "core/post-title": {
        "typography": { "defaultFontSizes": false }
      },
      "core/query-pagination": {
        "typography": { "defaultFontSizes": false }
      }
    }
  },

  "styles": {
    "spacing": {
      "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
    },
    "blocks": {
      "core/paragraph": { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/heading":   { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/list":      { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/group":     { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/column":    { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/columns":   { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/image":     { "spacing": { "margin": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } }
    },
    "elements": {
      "button": {
        "color": {
          "background": "transparent",
          "text": "inherit"
        },
        "spacing": {
          "padding": {
            "top": "0", "right": "0", "bottom": "0", "left": "0"
          }
        },
        "typography": {
          "fontFamily":     "inherit",
          "fontSize":       "inherit",
          "fontStyle":      "inherit",
          "fontWeight":     "inherit",
          "letterSpacing":  "inherit",
          "lineHeight":     "inherit",
          "textDecoration": "none",
          "textTransform":  "inherit"
        }
      }
    }
  },

  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],

  "customTemplates": [
    { "name": "blank", "title": "Blank", "postTypes": ["page"] }
  ]
}
