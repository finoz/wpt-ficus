{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {
    "color": {
      "palette": [
        { "slug": "primary",     "color": "#000000", "name": "Primary" },
        { "slug": "secondary",   "color": "#333333", "name": "Secondary" },
        { "slug": "accent",      "color": "#666666", "name": "Accent" },
        { "slug": "surface",     "color": "#F5F5F5", "name": "Surface" },
        { "slug": "surface-alt", "color": "#E5E5E5", "name": "Surface Alt" },
        { "slug": "text",        "color": "#111111", "name": "Text" },
        { "slug": "text-light",  "color": "#555555", "name": "Text Light" },
        { "slug": "white",       "color": "#FFFFFF", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "system-ui, sans-serif"
        },
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "Georgia, serif"
        }
      ]
    }
  }
}
